# Wallet address that receives USDC. Required.
PAY_TO=0xYourWalletAddress

# base-sepolia (testnet, default) or base (real money)
NETWORK=base-sepolia

# Price per hug, in USD
PRICE=$0.50

# Public address of the site, used in llms.txt, /api/menu and the page
PUBLIC_URL=https://your-domain.example

PORT=3000

# Mainnet only: Coinbase Developer Platform keys for the hosted facilitator
# (https://portal.cdp.coinbase.com). Leave empty on testnet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional: use a different facilitator instead of x402.org (testnet) or CDP (mainnet)
# FACILITATOR_URL=
